{
  "name": "total-tracking",
  "version": "1.0.0",
  "description": "Desktop Tracker & Companion App para Total War: WARHAMMER III (Estilo Ludohall + BTD6)",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev:vite": "vite",
    "dev:electron": "wait-on tcp:5173 && npm run build:electron && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "dev": "concurrently -k \"npm run dev:vite\" \"npm run dev:electron\"",
    "build:vite": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json && node -e \"const fs=require('fs'); fs.mkdirSync('dist-electron/assets', {recursive:true}); if (fs.existsSync('electron/assets/icon.ico')) fs.copyFileSync('electron/assets/icon.ico', 'dist-electron/assets/icon.ico'); if (fs.existsSync('electron/assets/tray-icon.png')) fs.copyFileSync('electron/assets/tray-icon.png', 'dist-electron/assets/tray-icon.png');\"",
    "build": "npm run build:vite && npm run build:electron",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "dist": "npm run build && electron-builder",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.totaltracking.app",
    "productName": "Total Tracking",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron/assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Total Tracking",
      "runAfterFinish": true
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "electron/assets/**/*"
    ]
  },
  "keywords": [
    "totalwar",
    "warhammer3",
    "tracker",
    "companion",
    "btd6",
    "ludohall"
  ],
  "author": "Antigravity",
  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.11.1",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "wait-on": "^8.0.2"
  }
}
